# The Google account that owns this project. Every make target that reaches
# Google Cloud refuses to run without it, and pins gcloud to it, so a personal
# deploy can never land on a work account that happens to be active.
GCLOUD_ACCOUNT=

# Empty means the app uses its in-memory store. Set this only when you intend
# to use Firestore (Application Default Credentials or the emulator required).
# `make run` clears it regardless: running locally must never write to real
# data because a variable happened to be set.
GOOGLE_CLOUD_PROJECT=
PORT=8080

# Anything the Makefile derives — service account emails, image URIs — is
# deliberately absent here. Defining one as an empty value would win over the
# Makefile default and break the deploy.
