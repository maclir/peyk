rules_version = '2';

// Browsers only read, and only the owner: the account `peyk owner` marked
// with the owner claim. The laptop agent and the server write with service
// account credentials, which these rules do not apply to.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.owner == true;
    }

    match /sessions/{id} {
      allow read: if isOwner();
    }

    match /laptop/status {
      allow get: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
