rules_version = '2';

// The owner is the account `peyk owner` marked with the owner claim. It reads
// what the laptop publishes and adds and removes queued tasks. The laptop
// agent writes with service account credentials, which these rules do not
// apply to.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.owner == true;
    }

    function boundedString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    match /sessions/{id} {
      allow read: if isOwner();
    }

    match /projects/{id} {
      allow read: if isOwner();
    }

    match /laptop/{doc} {
      allow get: if isOwner() && doc in ['status', 'push', 'usage', 'actions', 'version', 'models'];
    }

    // A phone's Web Push endpoint. The id is a hash of the endpoint, so a
    // phone that subscribes again replaces nothing and adds nothing.
    match /subscriptions/{id} {
      allow create: if isOwner()
        && id.size() >= 20 && id.size() <= 128
        && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'created_at'])
        && boundedString(request.resource.data.endpoint, 2048)
        && request.resource.data.endpoint.matches('https://.*')
        && boundedString(request.resource.data.p256dh, 200)
        && boundedString(request.resource.data.auth, 100)
        && request.resource.data.created_at == request.time;
      allow get, delete: if isOwner();
    }

    // A task names a project the laptop published. Only the agent marks it
    // dispatched or done. The phone edits a task's text, project or images
    // while it is queued, and deletes it while queued or once done, never while a session
    // is working on it.
    function validTarget(data) {
      return boundedString(data.project, 200)
        && !data.project.matches('.*/.*')
        && exists(/databases/$(database)/documents/projects/$(data.project))
        && boundedString(data.text, 20000);
    }

    // A hidden project takes no new tasks, and no task moves to one. A task
    // already queued for it may still be edited or reordered.
    function visibleTarget(data) {
      return get(/databases/$(database)/documents/projects/$(data.project)).data.get('hidden', false) != true;
    }

    // The phone's order for queued tasks; a task without one sorts by when
    // it was made.
    function validRank(data) {
      return !('rank' in data) || data.rank is number;
    }

    // The kind of page a task asks for instead of a code change.
    function validPrototype(data) {
      return !('prototype' in data) || data.prototype in ['html', 'design', 'any'];
    }

    // An ideation task's lenses and limit, which the laptop checks again.
    // A task asks for a prototype or for ideas, not both.
    function validIdeate(data) {
      return !('ideate' in data)
        || (!('prototype' in data)
          && data.ideate is map
          && data.ideate.keys().hasOnly(['lenses', 'max'])
          && data.ideate.lenses is list
          && data.ideate.lenses.size() >= 1 && data.ideate.lenses.size() <= 11
          && data.ideate.lenses.hasOnly(['reuse', 'experience', 'architecture', 'security', 'features', 'simplify', 'tests', 'performance', 'accessibility', 'ui', 'show'])
          && data.ideate.max in [3, 5, 10]);
    }

    // A task's images are created in the same batch as the task, so they
    // are checked as they will be after it.
    function imageExists(images, i) {
      return images.size() <= i
        || (images[i] is string && existsAfter(/databases/$(database)/documents/attachments/$(images[i])));
    }

    function validImages(data) {
      return !('images' in data)
        || (data.images is list && data.images.size() >= 1 && data.images.size() <= 4
          && imageExists(data.images, 0) && imageExists(data.images, 1)
          && imageExists(data.images, 2) && imageExists(data.images, 3));
    }

    match /tasks/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['project', 'text', 'created_at', 'status', 'images', 'rank', 'prototype', 'ideate'])
        && validTarget(request.resource.data)
        && visibleTarget(request.resource.data)
        && validRank(request.resource.data)
        && validPrototype(request.resource.data)
        && validIdeate(request.resource.data)
        && validImages(request.resource.data)
        && request.resource.data.created_at == request.time
        && request.resource.data.status == 'queued';
      allow update: if isOwner()
        && resource.data.status == 'queued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['project', 'text', 'rank', 'images', 'prototype', 'ideate'])
        && validTarget(request.resource.data)
        && (request.resource.data.project == resource.data.project || visibleTarget(request.resource.data))
        && validRank(request.resource.data)
        && validPrototype(request.resource.data)
        && validIdeate(request.resource.data)
        && validImages(request.resource.data);
      allow delete: if isOwner() && resource.data.status in ['queued', 'done'];
    }

    // An idea the laptop filed from an ideation run. The phone dismisses an
    // open idea, with an optional note for later runs, or takes the
    // dismissal back; or it adds the idea to the inbox, in the same batch as
    // the task it becomes. Ideas are never deleted, so later runs are told
    // about them.
    match /ideas/{id} {
      allow read: if isOwner();
      allow update: if isOwner() && (dismissIdea() || reopenIdea() || addIdea());
    }

    function ideaChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function dismissIdea() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'dismissed'
        && ideaChanges(['status', 'note'])
        && (!('note' in request.resource.data) || boundedString(request.resource.data.note, 500));
    }

    function reopenIdea() {
      return resource.data.status == 'dismissed'
        && request.resource.data.status == 'open'
        && ideaChanges(['status', 'note'])
        && !('note' in request.resource.data);
    }

    function addIdea() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'added'
        && ideaChanges(['status', 'added_task'])
        && boundedString(request.resource.data.added_task, 100)
        && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.added_task)).data.project == resource.data.project;
    }

    // An image attached to a task, named by the SHA-256 of its bytes, which
    // the laptop checks against the signed dispatch. It is never changed:
    // other bytes are another image.
    match /attachments/{id} {
      allow create: if isOwner()
        && id.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['data', 'type', 'created_at'])
        && request.resource.data.data is bytes
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.type in ['image/png', 'image/jpeg', 'image/webp', 'image/gif']
        && request.resource.data.created_at == request.time;
      allow get, delete: if isOwner();
    }

    // The laptop checks every command's passkey signature against keys it
    // holds locally; these rules only keep the documents well-formed and
    // write-once, so a signed payload cannot be replayed into a reused id.
    // The one change the phone makes is to withdraw a reply still waiting
    // for the laptop; the payload stays as it was signed.
    match /commands/{id} {
      allow read: if isOwner();
      allow update: if isOwner()
        && resource.data.type == 'reply'
        && resource.data.status in ['pending', 'held']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['type', 'payload', 'assertion', 'grant', 'status', 'created_at'])
        && request.resource.data.type in ['dispatch', 'reply', 'answer', 'clear', 'stop', 'start', 'restart', 'resume', 'push', 'check', 'update', 'hide', 'show', 'model']
        && boundedString(request.resource.data.payload, 30000)
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && (!('assertion' in request.resource.data) || isAssertion(request.resource.data.assertion))
        && (!('grant' in request.resource.data)
          || (request.resource.data.grant is map
            && request.resource.data.grant.keys().hasOnly(['statement', 'assertion', 'signature'])
            && boundedString(request.resource.data.grant.statement, 1024)
            && boundedString(request.resource.data.grant.signature, 256)
            && isAssertion(request.resource.data.grant.assertion)));
    }

    function isAssertion(a) {
      return a is map && a.keys().hasOnly(['credential_id', 'authenticator_data', 'client_data_json', 'signature']);
    }

    // A session's whole conversation, which the laptop writes only while the
    // phone asks for it. The phone may only stamp a request with the server's
    // time, and delete the document once it is done reading.
    match /history/{id} {
      allow get, delete: if isOwner();
      allow create: if isOwner()
        && exists(/databases/$(database)/documents/sessions/$(id))
        && request.resource.data.keys().hasOnly(['requested_at'])
        && request.resource.data.requested_at == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requested_at'])
        && request.resource.data.requested_at == request.time;
    }

    // A device saying it showed a session, so the laptop has every device
    // close that session's notifications. The agent deletes it once handled.
    match /seen/{id} {
      allow create, update: if isOwner()
        && exists(/databases/$(database)/documents/sessions/$(id))
        && request.resource.data.keys().hasOnly(['seen_at'])
        && request.resource.data.seen_at == request.time;
    }

        // A new passkey's public half, under the one-time code `peyk pair`
    // printed. The laptop shows its fingerprint and asks before trusting it.
    match /pairings/{code} {
      allow create: if isOwner()
        && code.size() >= 20 && code.size() <= 64
        && request.resource.data.keys().hasOnly(['credential_id', 'public_key', 'alg', 'created_at'])
        && boundedString(request.resource.data.credential_id, 1024)
        && boundedString(request.resource.data.public_key, 4096)
        && request.resource.data.alg is int
        && request.resource.data.created_at == request.time;
    }

    // A self-contained HTML prototype a worker published with `peyk publish`.
    // Only the laptop agent writes them; the phone reads one by its hash to
    // render in /sandbox and may delete it.
    match /prototypes/{id} {
      allow get, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
